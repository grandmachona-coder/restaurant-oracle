rules_version = '2';

/**
 * Cloud Storage security — receipt photos (Margin/Receipts feature).
 *
 * - Receipt images live under /tenants/{tenantId}/receipts/ — path-level tenant isolation,
 *   mirroring the Firestore strategy.
 * - Reads: approved members of the matching tenant, or super admins. (Primary read path is
 *   actually a short-lived V4 signed URL minted by the `receiptImageUrl` Cloud Function, which
 *   bypasses these rules; this member-read rule is defense-in-depth for any direct SDK access.)
 * - Writes: DENIED for all clients. Images are written server-side by the `receiptScan` Cloud
 *   Function via the Admin SDK, which bypasses rules.
 */
service firebase.storage {
  match /b/{bucket}/o {

    function isApprovedForTenant(tenantId) {
      return request.auth != null
        && request.auth.token.approved == true
        && request.auth.token.tenantId == tenantId;
    }
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.superAdmin == true;
    }

    // Receipt images: tenant-scoped read; server-side writes only.
    match /tenants/{tenantId}/receipts/{file=**} {
      allow read: if isSuperAdmin() || isApprovedForTenant(tenantId);
      allow write: if false;
    }

    // Everything else: locked down.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
