{
  "appId": "com.bistrosteward.app",
  "appName": "Bistro Steward",
  "webDir": "firebase/public",
  "server": {
    "url": "https://restaurant-oracle.web.app/app",
    "cleartext": false,
    "allowNavigation": [
      "restaurant-oracle.web.app",
      "restaurant-oracle.firebaseapp.com",
      "*.firebaseapp.com",
      "accounts.google.com",
      "apis.google.com",
      "*.google.com"
    ]
  },
  "ios": {
    "contentInset": "always"
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": ["google.com", "apple.com"]
    }
  }
}
